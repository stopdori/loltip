# Cloudflare Workers 정적 에셋 응답 헤더 (Vercel에서는 쓰이지 않는 일반 파일)
# Workers 정적 에셋은 기본이 max-age=0, must-revalidate라 브라우저가 매번 재검증한다.
# _next/static은 파일명에 해시가 들어가 내용이 바뀌면 주소도 바뀌므로 Next 기본값과 같이 1년 immutable로 둔다.
# https://opennext.js.org/cloudflare/caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# public/ 이미지는 파일명에 해시가 없고 같은 이름으로 내용만 교체되는 경우가 있어(챔피언·스킬·CC 아이콘 등)
# immutable 대신 1주만 재검증 없이 캐시한다. 교체 후 최대 1주까지는 옛 이미지가 보일 수 있다.
/champs/*
  Cache-Control: public,max-age=604800
/spells/*
  Cache-Control: public,max-age=604800
/spell-icons/*
  Cache-Control: public,max-age=604800
/stat-icons/*
  Cache-Control: public,max-age=604800
/cc-icons/*
  Cache-Control: public,max-age=604800
/tiers/*
  Cache-Control: public,max-age=604800
/ui/*
  Cache-Control: public,max-age=604800
